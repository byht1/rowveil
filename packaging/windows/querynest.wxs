<?xml version="1.0" encoding="UTF-8"?>
<!--
  QueryNest MSI installer (WiX Toolset 5).
  Build: packaging/windows/build-msi.ps1 (needs the WiX 5 dotnet tool, see that script)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="QueryNest"
           Manufacturer="QueryNest"
           Version="$(var.Version)"
           UpgradeCode="6F8E2B3A-9C41-4D7E-B5A2-3E1F0C7D9A54"
           Scope="perMachine"
           Language="1033">

    <SummaryInformation Description="QueryNest — database explorer and query tool" Manufacturer="QueryNest" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of QueryNest is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="$(var.Root)\assets\querynest.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://byht1.github.io/querynest/" />
    <Property Id="ARPHELPLINK" Value="https://github.com/byht1/querynest/issues" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/byht1/querynest/releases" />

    <!-- Folders -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="QueryNest" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- Program -->
    <Component Id="MainExe" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="QueryNestExe" Source="$(var.Root)\target\release\querynest.exe" KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder" Bitness="always64">
      <Shortcut Id="StartMenuShortcut" Name="QueryNest" Description="Database explorer and query tool"
                Target="[INSTALLFOLDER]querynest.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\QueryNest" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Component Id="DesktopShortcut" Directory="DesktopFolder" Bitness="always64">
      <Shortcut Id="DesktopShortcut" Name="QueryNest" Description="Database explorer and query tool"
                Target="[INSTALLFOLDER]querynest.exe" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon" />
      <RegistryValue Root="HKCU" Key="Software\QueryNest" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- "Open with → QueryNest" for SQLite files. The default app for these files does not change. -->
    <Component Id="FileAssociations" Directory="INSTALLFOLDER" Bitness="always64">
      <RegistryValue Root="HKLM" Key="Software\Classes\QueryNest.SQLiteDatabase" Value="SQLite database" Type="string" KeyPath="yes" />
      <RegistryValue Root="HKLM" Key="Software\Classes\QueryNest.SQLiteDatabase\DefaultIcon" Value="&quot;[INSTALLFOLDER]querynest.exe&quot;,0" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\QueryNest.SQLiteDatabase\shell\open\command" Value="&quot;[INSTALLFOLDER]querynest.exe&quot; &quot;%1&quot;" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.db\OpenWithProgids" Name="QueryNest.SQLiteDatabase" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.db3\OpenWithProgids" Name="QueryNest.SQLiteDatabase" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.sqlite\OpenWithProgids" Name="QueryNest.SQLiteDatabase" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\.sqlite3\OpenWithProgids" Name="QueryNest.SQLiteDatabase" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\querynest.exe" Name="FriendlyAppName" Value="QueryNest" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\querynest.exe\SupportedTypes" Name=".db" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\querynest.exe\SupportedTypes" Name=".sqlite" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\querynest.exe\SupportedTypes" Name=".sqlite3" Value="" Type="string" />
      <RegistryValue Root="HKLM" Key="Software\Classes\Applications\querynest.exe\SupportedTypes" Name=".db3" Value="" Type="string" />
    </Component>

    <Component Id="ServerExe" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="QueryNestServerExe" Source="$(var.Root)\target\release\querynest-server.exe" KeyPath="yes" />
    </Component>

    <!-- Features (shown in the "Custom Setup" page) -->
    <Feature Id="Main" Title="QueryNest" Description="The desktop app and its Start menu shortcut." Level="1"
             AllowAbsent="no" ConfigurableDirectory="INSTALLFOLDER" Display="expand">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="StartMenuShortcut" />
      <Feature Id="Desktop" Title="Desktop shortcut" Description="A QueryNest shortcut on the desktop." Level="1">
        <ComponentRef Id="DesktopShortcut" />
      </Feature>
      <Feature Id="OpenWith" Title="Open SQLite files with QueryNest"
               Description="Adds QueryNest to “Open with” for .db, .db3, .sqlite and .sqlite3 files. Your default app for these files does not change." Level="1">
        <ComponentRef Id="FileAssociations" />
      </Feature>
      <Feature Id="Server" Title="Web server (querynest-server.exe)"
               Description="Optional. Serves the same UI to a web browser, for example on a server. Not needed for the desktop app." Level="2">
        <ComponentRef Id="ServerExe" />
      </Feature>
    </Feature>

    <!-- UI: Welcome → License → Custom setup → Where QueryNest keeps its files → Install → Finish -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Root)\packaging\windows\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Root)\packaging\windows\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Root)\packaging\windows\dialog.bmp" />

    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch QueryNest" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- SetProperty (not Property) so that [AppDataFolder] is expanded to the real path. -->
    <SetProperty Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Your connections and settings are stored in [AppDataFolder]querynest. Uninstalling QueryNest keeps them." After="CostFinalize" Sequence="ui" />
    <!-- Starts the app from the Finish page as the signed-in user (not elevated). -->
    <CustomAction Id="LaunchQueryNest" Directory="INSTALLFOLDER" ExeCommand="explorer.exe &quot;[#QueryNestExe]&quot;" Return="asyncNoWait" Impersonate="yes" />

    <UI>
      <TextStyle Id="QN_Font_Bold" FaceName="Segoe UI" Size="8" Bold="yes" />
      <Dialog Id="DataInfoDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="290" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Where QueryNest keeps its files" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="290" Height="15" Transparent="yes" NoPrefix="yes" Text="Everything stays on this computer. Nothing is sent anywhere." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="ProgramHead" Type="Text" X="20" Y="54" Width="330" Height="12" NoPrefix="yes" Text="{\QN_Font_Bold}Program (for all users)" />
        <Control Id="ProgramPath" Type="Text" X="30" Y="67" Width="320" Height="12" NoPrefix="yes" Text="[INSTALLFOLDER]" />
        <Control Id="ProgramNote" Type="Text" X="30" Y="79" Width="320" Height="12" NoPrefix="yes" Text="querynest.exe, plus Start menu and desktop shortcuts" />

        <Control Id="DataHead" Type="Text" X="20" Y="98" Width="330" Height="12" NoPrefix="yes" Text="{\QN_Font_Bold}Your data (separately for each Windows user)" />
        <Control Id="DataPath" Type="Text" X="30" Y="111" Width="320" Height="12" NoPrefix="yes" Text="[AppDataFolder]querynest\" />
        <Control Id="Data1" Type="Text" X="36" Y="125" Width="314" Height="20" NoPrefix="yes" Text="connections.json — saved connections. Passwords are stored as plain text inside the connection URLs." />
        <Control Id="Data2" Type="Text" X="36" Y="146" Width="314" Height="10" NoPrefix="yes" Text="window.json — window size and position" />
        <Control Id="Data3" Type="Text" X="36" Y="157" Width="314" Height="10" NoPrefix="yes" Text="querynest.log — log of the last run" />
        <Control Id="Data4" Type="Text" X="36" Y="168" Width="314" Height="10" NoPrefix="yes" Text="webview\ — the app's browser cache" />

        <Control Id="UninstallHead" Type="Text" X="20" Y="186" Width="330" Height="12" NoPrefix="yes" Text="{\QN_Font_Bold}Uninstalling" />
        <Control Id="UninstallNote" Type="Text" X="30" Y="199" Width="320" Height="28" NoPrefix="yes" Text="Removes the program, shortcuts and “Open with” entries. Your data folder stays; delete it to remove saved connections." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="CustomizeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <!-- Insert DataInfoDlg between CustomizeDlg and VerifyReadyDlg (a later NewDialog wins). -->
      <Publish Dialog="CustomizeDlg" Control="Next" Event="NewDialog" Value="DataInfoDlg" Order="10" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DataInfoDlg" Order="10" Condition="NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchQueryNest" Order="10"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
  </Package>
</Wix>
