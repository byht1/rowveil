{
  "name": "roostbase-ui-vendor",
  "private": true,
  "description": "Builds static/vendor/codemirror.js (CodeMirror 6 + sql-formatter) embedded into the Rust binary",
  "type": "module",
  "scripts": {
    "build": "esbuild entry.js --bundle --format=esm --minify --legal-comments=none --target=es2020 --outfile=../static/vendor/codemirror.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "sql-formatter": "15.9.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
